# Revora AI Environment Variables
# Copy to .env and fill in actual values (backend only)

# Application
APP_MODE=lite  # lite or full
DEBUG=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-public-anon-key-here

# Frontend (Vercel)
VITE_API_URL=http://localhost:8000  # local dev; change for production
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# CORS
CORS_ORIGIN=http://localhost:5173  # Vite dev server, or Vercel URL in prod
